# Copie este arquivo para .env.local e preencha com valores reais.
# NUNCA commite .env.local ou qualquer arquivo com valores reais preenchidos.

# --- Supabase ---
# URL e chave anônima (pública, protegida por RLS) do seu projeto Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de service role do Supabase. NUNCA exponha esta chave ao client.
# Usada apenas em código server-side (API routes / webhook) para operações
# que precisam ignorar RLS de forma controlada (ex: gravar transações sincronizadas
# da Pluggy em nome do usuário dono da conexão).
SUPABASE_SERVICE_ROLE_KEY=

# --- Pluggy (Open Finance) ---
# Credenciais da aplicação Pluggy. Usadas SOMENTE no backend.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Segredo usado para validar a assinatura dos webhooks enviados pela Pluggy.
PLUGGY_WEBHOOK_SECRET=
# Use "sandbox" durante desenvolvimento e "production" quando for usar dados reais.
PLUGGY_ENV=sandbox

# --- Rate limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cron / sync job ---
# Segredo que a rota de polling (/api/pluggy/sync) exige no header Authorization,
# evitando que qualquer pessoa dispare a sincronização publicamente.
CRON_SECRET=

# --- Aplicação ---
# URL pública da aplicação, usada para restringir CORS e montar a CSP.
# Em desenvolvimento: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
