# Copie para .env.local e preencha com valores reais.
# NUNCA commite .env.local ou qualquer arquivo com valores reais preenchidos.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# NUNCA exponha esta chave ao client — só é usada nos fluxos sem sessão de
# usuário (webhook e polling da Pluggy). Toda requisição de um usuário logado
# é atendida com a chave anônima + o access token dele (RLS aplicado).
SUPABASE_SERVICE_ROLE_KEY=

# --- Pluggy (Open Finance) ---
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_WEBHOOK_SECRET=
PLUGGY_ENV=sandbox

# --- Rate limiting (Upstash Redis) ---
# Mesmo banco usado por apps/web (login/cadastro) — os prefixos de chave no
# código evitam colisão entre os dois usos.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cron / sync job ---
CRON_SECRET=

# --- CORS ---
# URL do frontend (apps/web). Único valor aceito em Access-Control-Allow-Origin.
WEB_APP_URL=http://localhost:3000

# --- Local dev ---
PORT=3001
