# Desenvolvimento local: copie para .dev.vars (gitignored, lido por
# `wrangler dev`). Em produção, os valores não secretos ficam em `vars` no
# wrangler.jsonc e os secrets entram com `wrangler secret put <NOME>`.
# NUNCA commite .dev.vars ou qualquer arquivo com valores reais preenchidos.

# --- Cloudflare Access (valida o JWT do usuário) ---
# Domínio do time Zero Trust (ex: meutime.cloudflareaccess.com) e o AUD da
# aplicação Access que protege apps/web.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# --- Pluggy (Open Finance) ---
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_WEBHOOK_SECRET=
PLUGGY_ENV=sandbox

# --- Rate limiting (Upstash Redis) ---
# Mesmo banco usado por apps/web — os prefixos de chave no código evitam
# colisão entre os dois usos.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cron / sync job ---
CRON_SECRET=

# --- CORS ---
# URL do frontend (apps/web). Único valor aceito em Access-Control-Allow-Origin.
WEB_APP_URL=http://localhost:3000
