{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "azulito-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "triggers": { "crons": ["0 3 * * *"] },
  "vars": { "WEB_APP_URL": "https://REPLACE-WITH-WEB-URL" }
}
