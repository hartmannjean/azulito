{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "azulito-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "azulito-api.hartmanns.com.br", "custom_domain": true }],
  "observability": { "enabled": true },
  "triggers": { "crons": ["0 3 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "azulito",
      "database_id": "0389f933-0cb4-441f-9a43-847d687b350c",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "WEB_APP_URL": "https://azulito.hartmanns.com.br",
    "CF_ACCESS_TEAM_DOMAIN": "wild-night-aa2a.cloudflareaccess.com",
    "CF_ACCESS_AUD": "0a95046b1ea248cd5fffedc53a39de526e796643455ad894472eefe50a8d8485"
  }
}
