{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "azulito-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // A api NÃO tem endereço público: só o web a alcança, por service binding. Isso é
  // parte da segurança (o IP e a sessão que o web repassa só são confiáveis assim).
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // O D1 fica em ENAM e cada chamada faz várias consultas em sequência: rodar a api perto
  // do banco troca N viagens oceânicas por uma.
  "placement": { "mode": "smart" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "azulito",
      "database_id": "0389f933-0cb4-441f-9a43-847d687b350c",
      "migrations_dir": "migrations"
    }
  ],
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    // Conta CADA chamada interna da api (uma página faz de 5 a 16); 120/min derrubava o uso normal.
    { "name": "RATE_LIMITER_USER", "namespace_id": "1002", "simple": { "limit": 600, "period": 60 } }
  ],
  "r2_buckets": [{ "binding": "OFX_BUCKET", "bucket_name": "azulito-ofx" }],
  "vars": {
    "WEB_APP_URL": "https://azulito.hartmanns.com.br",
    "MAIL_FROM": "Azulito <login@hartmanns.com.br>",
    "SIGNUPS_ENABLED": "true"
  }
}
