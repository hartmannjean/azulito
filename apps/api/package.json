{
  "name": "@azulito/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "predeploy": "npm run build --prefix ../../packages/shared",
    "deploy": "wrangler deploy",
    "prebuild": "npm run build --prefix ../../packages/shared",
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply azulito --local",
    "db:migrate:remote": "wrangler d1 migrations apply azulito --remote",
    "test": "node --experimental-strip-types --no-warnings --import ./tests/support/register.mjs --test tests/*.test.ts",
    "check:sql": "node --experimental-strip-types --no-warnings scripts/check-sql-scope.mts",
    "test:mutation": "node scripts/mutation-isolation.mjs isolation && node scripts/mutation-isolation.mjs limits && node scripts/mutation-isolation.mjs account && node scripts/mutation-isolation.mjs cutover"
  },
  "dependencies": {
    "@azulito/shared": "0.1.0",
    "@better-auth/core": "1.7.14",
    "@better-auth/passkey": "1.7.14",
    "better-auth": "1.7.14",
    "cors": "2.8.6",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.4.1",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "wrangler": "4.156.0"
  }
}
