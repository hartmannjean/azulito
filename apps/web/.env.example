# Copie para .env.local e preencha com valores reais.
# NUNCA commite .env.local ou qualquer arquivo com valores reais preenchidos.

# --- Cloudflare Access ---
# Em produção o Access protege o app na borda e injeta o JWT em cada request.
# Domínio do time Zero Trust e AUD da aplicação Access (usados para VERIFICAR
# o JWT em lib/access.ts).
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# --- Rate limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Backend (apps/api) ---
# Só usado sem o service binding `API` (ex: `next dev`). Em produção a
# chamada vai por service binding, configurado em wrangler.jsonc.
API_BASE_URL=http://localhost:8787
