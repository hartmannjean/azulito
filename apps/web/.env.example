# Copie para .env.local e preencha com valores reais.
# NUNCA commite .env.local ou qualquer arquivo com valores reais preenchidos.

# --- Supabase ---
# URL e chave anônima (pública, protegida por RLS) do seu projeto Supabase.
# Usadas aqui só para autenticação (login/cadastro/sessão) — dados de
# transações/conexões bancárias vêm da apps/api, não de uma query direta.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Rate limiting (Upstash Redis) ---
# Mesmo banco usado por apps/api — os prefixos de chave no código evitam
# colisão entre os dois usos.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Backend (apps/api) ---
# URL da API separada. Chamada só a partir do servidor (Server Components /
# Server Actions) — nunca diretamente do browser, então não precisa do
# prefixo NEXT_PUBLIC_.
API_BASE_URL=http://localhost:3001

# --- Aplicação ---
# URL pública desta própria app, usada para montar a CSP.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
