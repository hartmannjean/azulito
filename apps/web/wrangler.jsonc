{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "azulito-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "azulito-web" },
    { "binding": "API", "service": "azulito-api" }
  ],
  "routes": [{ "pattern": "azulito.hartmanns.com.br", "custom_domain": true }],
  "observability": { "enabled": true },
  "vars": {
    "CF_ACCESS_TEAM_DOMAIN": "wild-night-aa2a.cloudflareaccess.com",
    "CF_ACCESS_AUD": "0a95046b1ea248cd5fffedc53a39de526e796643455ad894472eefe50a8d8485"
  }
}
