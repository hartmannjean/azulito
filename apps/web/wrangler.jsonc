{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "azulito-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "azulito-web" },
    { "binding": "API", "service": "azulito-api" }
  ],
  "routes": [{ "pattern": "azulito.hartmanns.com.br", "custom_domain": true }],
  // Só o domínio próprio atende: sem URL *.workers.dev esquecida ligada.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Chave PÚBLICA do Turnstile (a secret fica só como secret da api).
  "vars": { "TURNSTILE_SITE_KEY": "0x4AAAAAAF1NNdJLdkdMWcFQ" }
}
